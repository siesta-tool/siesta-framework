CREATE TABLE IF NOT EXISTS events_raw (
    pos       BIGINT,
    case_id  STRING,
    activity  STRING,
    event_ts  BIGINT,
    EventOrigin  STRING,
    Action  STRING,
    lifecycle_transition  STRING,
    org_resource  STRING
) WITH (
    'connector' = 'filesystem',
    'path' = 'file:///tmp/mr_data',
    'format' = 'csv'
)
  VIEW:
CREATE VIEW events AS
    SELECT pos, case_id, activity, event_ts, EventOrigin, Action, lifecycle_transition, org_resource,
           TO_TIMESTAMP_LTZ(event_ts, 3) AS ts
    FROM events_raw
