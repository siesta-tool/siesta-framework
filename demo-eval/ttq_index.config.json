{
  "log_name": "ttq_bpic2017",
  "storage_namespace": "siesta",
  "clear_existing": true,
  "enable_streaming": true,
  "kafka_topic": "ttq_bpic2017",
  "lookback": "3650d",
  "field_mappings": {
    "json": {
      "activity": "activity",
      "trace_id": "trace_id",
      "position": "position",
      "start_timestamp": "timestamp",
      "attributes": ["_produced_at", "_lambda"]
    }
  },
  "trace_level_fields": ["trace_id"],
  "timestamp_fields": ["start_timestamp"],
  "ttq_logging": true,
  "ttq_lambda": -1,
  "ttq_log_path": "demo-eval/ttq_batches.csv"
}
